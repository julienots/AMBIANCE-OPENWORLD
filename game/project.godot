; SYMBIOTE: ABYSS — SuperEssence studio
config_version=5

[application]

config/name="SYMBIOTE: ABYSS"
config/description="Action-aventure cartoon 3D, super-héros, survie horrifique et base souterraine."
config/version="0.1.0"
run/main_scene="res://src/boot/boot.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/branding/boot_splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/icon="res://assets/branding/icon.png"
run/max_fps=60

[autoload]

Events="*res://src/autoload/events.gd"
DB="*res://src/autoload/db.gd"
Settings="*res://src/autoload/settings.gd"
Save="*res://src/autoload/save.gd"
Game="*res://src/autoload/game.gd"
Audio="*res://src/autoload/audio.gd"
Fx="*res://src/autoload/fx.gd"
Loader="*res://src/autoload/loader.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=true

[gui]

theme/custom_font="res://assets/fonts/Nunito.ttf"
theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size=2048
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)
